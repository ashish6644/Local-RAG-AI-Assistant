# Copy this file to ".env" (setup.bat does it for you) and edit as needed.
# Every value is optional; the defaults below are used when a line is missing.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# --- Generation ---
TEMPERATURE=0.2
TOP_P=0.9
MAX_OUTPUT_TOKENS=1024
CONTEXT_WINDOW=4096

# --- Chunking (applies to newly indexed documents) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNKING_STRATEGY=recursive      # recursive | character

# --- Retrieval ---
TOP_K=4
SIMILARITY_THRESHOLD=0.30        # 0.0 - 1.0 (cosine similarity)
SEARCH_STRATEGY=similarity       # similarity | mmr
HISTORY_WINDOW=6                 # number of recent messages sent to the model
USE_QUERY_REWRITING=true         # history-aware question rewriting
USE_MULTI_QUERY=false            # extra LLM call that expands the query

# --- Uploads / storage ---
MAX_UPLOAD_MB=50
DATA_DIR=data                    # relative paths are resolved from the project folder
LOG_DIR=logs
COLLECTION_NAME=documents
LOG_LEVEL=INFO
